POSTGRES_DB=civiclens_rag
POSTGRES_USER=civiclens
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://civiclens:change_me@localhost:5432/civiclens_rag
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
USE_OPENAI_EMBEDDINGS=false
ANSWER_PROVIDER=local
ANSWER_MODEL=gpt-4o-mini
ANSWER_TIMEOUT_SECONDS=30
ANSWER_MAX_RETRIES=2
USE_OPENAI_ANSWERS=false
OPENAI_API_KEY=

# Issue 13 privacy-conscious local observability. Raw questions and answers are
# never persisted by the current implementation.
OBSERVABILITY_ENABLED=false
OBSERVABILITY_CONNECT_TIMEOUT_SECONDS=3
# Issue 17: direct is dependency-free/default; langgraph is optional and bounded.
ORCHESTRATION_MODE=direct
LANGGRAPH_MAX_STEPS=8
LANGGRAPH_TOOL_CALL_LIMIT=1
RETRIEVAL_MODE=hybrid
SEMANTIC_CANDIDATE_COUNT=20
LEXICAL_CANDIDATE_COUNT=20
RRF_K=60
RERANKING_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_CANDIDATE_LIMIT=20

# Streamlit public API client (host-local defaults)
# Docker Compose uses its separate service-DNS override below.
CIVICLENS_API_BASE_URL=http://localhost:8000
CIVICLENS_DOCKER_API_BASE_URL=http://api:8000
CIVICLENS_API_TIMEOUT_SECONDS=30
